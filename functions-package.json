{
  "name": "new-friends-cloud-functions",
  "description": "Cloud Functions for New Friends app - Storage cleanup and monitoring",
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1"
  },
  "devDependencies": {},
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test-storage": "firebase functions:call getStorageStats",
    "test-cleanup": "firebase functions:call cleanupOldPostsManual"
  }
}
